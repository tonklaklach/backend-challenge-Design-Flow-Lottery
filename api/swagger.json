{
  "openapi": "3.1.1",
  "info": {
    "title": "Lottery Search and Allocation — Design Proposal",
    "version": "1.0.0-design",
    "description": "สเปคที่เสนอสำหรับโจทย์สลากหนึ่งล้านใบ รับข้อมูลธุรกิจผ่าน JSON body และ JWT ผ่าน Authorization header เป็นเอกสารออกแบบ ยังไม่มี server หรือผลวัดความเร็ว ส่วน confirm เป็นตัวเลือกเพิ่มเติมจากโจทย์ขั้นต่ำ"
  },
  "servers": [
    {
      "url": "https://lottery.example.test",
      "description": "URL สมมติสำหรับอ่านสเปค ยังไม่มี server ที่ URL นี้"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Lottery allocation",
      "description": "ค้นหาและจองสลากโดยตรวจเจ้าของ และเปลี่ยนข้อมูลที่เกี่ยวข้องให้สำเร็จพร้อมกัน"
    }
  ],
  "paths": {
    "/v1/tickets/search": {
      "post": {
        "operationId": "searchTickets",
        "summary": "ค้นหาและจองสลาก",
        "description": "ค้นหาและจองใน transaction เดียว key เดิมของผู้ใช้เดิมกับ pattern/limit เดิมคืนการจองเดิม หาก payload เปลี่ยนตอบ 409 IDEMPOTENCY_CONFLICT หากเลือกสลากไม่ได้ตอบ 409 ALLOCATION_UNAVAILABLE โดยไม่สร้าง reservation/key คืนให้น้อยกว่า limit ได้ ไม่มี total หรือลำดับที่รับประกัน การ retry ไม่ต่อเวลาและไม่เปิด terminal reservation กลับมา active หากหมดเวลาแล้วคืนประวัติด้วย 200",
        "tags": [
          "Lottery allocation"
        ],
        "requestBody": {
          "required": true,
          "description": "ต้องมี JSON body ส่ง business fields ผ่าน body เท่านั้น ปฏิเสธ unknown fields",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest",
                "description": "รูปแบบข้อมูลที่ต้องส่ง"
              },
              "example": {
                "pattern": "****23",
                "limit": 2,
                "idempotency_key": "search-user-a-001"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "สร้างและ commit การจองใหม่แล้ว",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse",
                  "description": "สร้างและ commit การจองใหม่แล้ว"
                },
                "example": {
                  "data": {
                    "reservation": {
                      "id": "ecad59f1-a023-40c1-9213-ef7f7cf396a0",
                      "user_id": "user-a",
                      "pattern": "****23",
                      "requested_count": 2,
                      "allocated_count": 2,
                      "status": "active",
                      "created_at": "2026-11-02T10:00:00Z",
                      "expires_at": "2026-11-02T10:05:00Z",
                      "updated_at": "2026-11-02T10:00:00Z",
                      "tickets": [
                        {
                          "ticket_id": "24",
                          "number": "000023"
                        },
                        {
                          "ticket_id": "124",
                          "number": "000123"
                        }
                      ]
                    },
                    "replayed": false
                  },
                  "request_id": "ea10a48c-1b1a-4a3c-8ea8-a8a9d198c539"
                }
              }
            }
          },
          "200": {
            "description": "คืน reservation เดิมพร้อมสถานะปัจจุบัน โดย replayed=true",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse",
                  "description": "คืน reservation เดิมพร้อมสถานะปัจจุบัน โดย replayed=true"
                },
                "example": {
                  "data": {
                    "reservation": {
                      "id": "ecad59f1-a023-40c1-9213-ef7f7cf396a0",
                      "user_id": "user-a",
                      "pattern": "****23",
                      "requested_count": 2,
                      "allocated_count": 2,
                      "status": "active",
                      "created_at": "2026-11-02T10:00:00Z",
                      "expires_at": "2026-11-02T10:05:00Z",
                      "updated_at": "2026-11-02T10:00:00Z",
                      "tickets": [
                        {
                          "ticket_id": "24",
                          "number": "000023"
                        },
                        {
                          "ticket_id": "124",
                          "number": "000123"
                        }
                      ]
                    },
                    "replayed": true
                  },
                  "request_id": "ea10a48c-1b1a-4a3c-8ea8-a8a9d198c539"
                }
              }
            }
          },
          "400": {
            "description": "ข้อมูลที่ส่งมาไม่ถูกต้อง",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                  "description": "ข้อมูลที่ส่งมาไม่ถูกต้อง"
                },
                "example": {
                  "error": {
                    "code": "INVALID_REQUEST",
                    "message": "Request validation failed."
                  },
                  "request_id": "ea10a48c-1b1a-4a3c-8ea8-a8a9d198c539"
                }
              }
            }
          },
          "401": {
            "description": "ไม่มี JWT ที่ตรวจผ่าน",
