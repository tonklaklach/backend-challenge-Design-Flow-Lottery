              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                  "description": "ไม่มี JWT ที่ตรวจผ่าน"
                },
                "example": {
                  "error": {
                    "code": "UNAUTHENTICATED",
                    "message": "Valid bearer token required."
                  },
                  "request_id": "ea10a48c-1b1a-4a3c-8ea8-a8a9d198c539"
                }
              }
            }
          },
          "409": {
            "description": "ไม่สามารถจัดสรรได้ หรือ payload/key/สถานะขัดแย้งตาม operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                  "description": "ไม่สามารถจัดสรรได้ หรือ payload/key/สถานะขัดแย้งตาม operation"
                },
                "example": {
                  "error": {
                    "code": "ALLOCATION_UNAVAILABLE",
                    "message": "No matching tickets can be allocated at this time."
                  },
                  "request_id": "ea10a48c-1b1a-4a3c-8ea8-a8a9d198c539"
                }
              }
            }
          },
          "429": {
            "description": "ส่งคำขอเกินเกณฑ์ที่กำหนด",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                  "description": "ส่งคำขอเกินเกณฑ์ที่กำหนด"
                },
                "example": {
                  "error": {
                    "code": "RATE_LIMITED",
                    "message": "Too many requests."
                  },
                  "request_id": "ea10a48c-1b1a-4a3c-8ea8-a8a9d198c539"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "จำนวนวินาทีขั้นต่ำที่แนะนำให้รอก่อนลองใหม่ ใช้ key เดิมและสุ่มเวลารอเพิ่มเล็กน้อย",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "required": true
              }
            }
          },
          "500": {
            "description": "ข้อผิดพลาดภายในระบบ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                  "description": "ข้อผิดพลาดภายในระบบ"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Internal server error."
                  },
                  "request_id": "ea10a48c-1b1a-4a3c-8ea8-a8a9d198c539"
                }
              }
            }
          },
          "503": {
            "description": "ระบบยังรับงานนี้ไม่ได้ชั่วคราว",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                  "description": "ระบบยังรับงานนี้ไม่ได้ชั่วคราว"
                },
                "example": {
                  "error": {
                    "code": "TEMPORARILY_UNAVAILABLE",
                    "message": "Allocation service temporarily unavailable."
                  },
                  "request_id": "ea10a48c-1b1a-4a3c-8ea8-a8a9d198c539"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "จำนวนวินาทีขั้นต่ำที่แนะนำให้รอก่อนลองใหม่ ใช้ key เดิมและสุ่มเวลารอเพิ่มเล็กน้อย",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "required": true
              }
            }
          },
          "504": {
            "description": "คำขอใช้เวลาเกินกำหนดและผล commit อาจยังไม่ชัดเจน",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                  "description": "คำขอใช้เวลาเกินกำหนดและผล commit อาจยังไม่ชัดเจน"
                },
                "example": {
                  "error": {
                    "code": "DEADLINE_EXCEEDED",
                    "message": "Request deadline exceeded."
                  },
                  "request_id": "ea10a48c-1b1a-4a3c-8ea8-a8a9d198c539"
                }
              }
            }
          }
        }
      }
    },
