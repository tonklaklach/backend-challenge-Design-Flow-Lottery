  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT แบบ HS256 ที่ตรวจ signature และ issuer ถูกต้อง มี exp และ sub ไม่ว่าง ตรวจ nbf/iat เมื่อมีค่า ไม่ส่ง signing secret มากับคำขอ ต้องตกลงวิธีเปลี่ยน key และผู้มีสิทธิ์ถือ key ก่อน production"
      }
    },
    "schemas": {
      "SearchRequest": {
        "type": "object",
        "description": "ข้อมูลสำหรับค้นหาและจองสลาก ทุก field ต้องส่ง",
        "properties": {
          "pattern": {
            "type": "string",
            "description": "คำค้นยาว 6 ตัว ใช้เลข ASCII 0–9 หรือ * เท่านั้น แต่ละ * แทนเลขหนึ่งหลัก ไม่ตัดช่องว่างให้",
            "minLength": 6,
            "maxLength": 6,
            "pattern": "^[0-9*]{6}$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "จำนวนใบสูงสุดที่ต้องการ ต้องระบุ 1–100 ไม่มีค่าเริ่มต้น ระบบอาจคืนให้น้อยกว่าที่ขอได้"
          },
          "idempotency_key": {
            "type": "string",
            "description": "รหัสคำขอที่ client สร้าง ใช้ค่าเดิมเมื่อ retry สำหรับผู้ใช้คนเดิม ห้ามว่าง/มีแต่ช่องว่าง/มี NUL และยาวไม่เกิน 128 UTF-8 bytes ไม่แก้ตัวใหญ่เล็กหรือตัดช่องว่างก่อนเทียบ",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?=.*\\S)[^\\u0000]+$",
            "x-maxUtf8Bytes": 128
          }
        },
        "required": [
          "pattern",
          "limit",
          "idempotency_key"
        ],
        "additionalProperties": false
      },
      "ReservationRequest": {
        "type": "object",
        "description": "ข้อมูลสำหรับ get, confirm หรือ release โดยส่ง ID ใน JSON body",
        "properties": {
          "reservation_id": {
            "type": "string",
            "description": "UUID ของการจองที่ต้องการใช้งาน ต้องเป็นของผู้ใช้ที่อยู่ใน JWT",
            "format": "uuid"
          }
        },
        "required": [
          "reservation_id"
        ],
        "additionalProperties": false
      },
      "Ticket": {
        "type": "object",
        "description": "สลากหนึ่งใบในผลการจองหรือประวัติ",
        "properties": {
          "ticket_id": {
            "type": "string",
            "description": "ID ของสลากใบจริง DB เก็บเป็น bigint แต่ API ส่งเป็น string ของเลขจำนวนเต็มบวก เพื่อไม่ให้ client อ่านเลขคลาดเคลื่อน",
            "pattern": "^[1-9][0-9]*$"
          },
          "number": {
            "type": "string",
            "description": "เลขสลาก 6 หลัก เก็บเป็น string เพื่อรักษาศูนย์นำหน้า คนละ ticket_id อาจมี number เดียวกันได้",
            "minLength": 6,
            "maxLength": 6,
            "pattern": "^[0-9]{6}$"
          }
        },
        "required": [
          "ticket_id",
          "number"
        ]
      },
      "Reservation": {
        "type": "object",
        "description": "ข้อมูลการจองของเจ้าของ หาก released/expired รายการ tickets เป็นประวัติ ไม่ใช่สิทธิ์จองที่ยังใช้งานได้",
        "properties": {
          "id": {
            "type": "string",
            "description": "UUID ของการจอง สร้างใหม่ต่อการจัดสรรครั้งใหม่ ไม่เอา ID เก่ากลับมาใช้",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "description": "เจ้าของการจองจาก sub ใน JWT ไม่รับให้ client เลือกผ่าน body ไม่เกิน 256 UTF-8 bytes",
            "minLength": 1,
            "maxLength": 256,
            "x-maxUtf8Bytes": 256
          },
          "pattern": {
            "type": "string",
            "description": "pattern ที่ใช้สร้างการจอง ยาว 6 ตัวเลข/* และไม่เปลี่ยนจากเดิม",
            "minLength": 6,
            "maxLength": 6,
            "pattern": "^[0-9*]{6}$"
          },
          "requested_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "limit ที่ผู้ใช้ขอไว้ครั้งแรก อยู่ระหว่าง 1–100 และไม่เปลี่ยนเมื่อ retry"
          },
          "allocated_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "จำนวนใบที่จองได้จริง อยู่ระหว่าง 1–100 ต้องเท่ากับ tickets.length และไม่เกิน requested_count"
          },
          "status": {
            "type": "string",
            "description": "active=กำลัง hold, confirmed=ยืนยันแล้ว, released=ผู้ใช้ยกเลิก, expired=หมดเวลา",
            "enum": [
              "active",
              "confirmed",
              "released",
              "expired"
            ]
          },
          "created_at": {
            "type": "string",
            "description": "เวลาสร้างจากฐานข้อมูล ส่งเป็น UTC รูปแบบ RFC 3339 เช่น 2026-11-02T10:00:00Z",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "description": "เวลาสิ้นสุด hold ต้องหลัง created_at หาก confirmed แล้วเวลานี้ไม่ทำให้การยืนยันหมดอายุ",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "description": "เวลาที่สถานะเปลี่ยนล่าสุดจากฐานข้อมูล ส่งเป็น UTC RFC 3339 การ retry ที่ไม่เปลี่ยนสถานะไม่แก้เวลานี้",
            "format": "date-time"
          },
          "tickets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "description": "สลากที่เคยได้จากการจองนี้ 1–100 ใบ ไม่รับประกันลำดับ เมื่อ released/expired แล้วยังคงคืนรายการเดิมเป็นประวัติ",
            "items": {
              "$ref": "#/components/schemas/Ticket",
              "description": "ID และเลขของสลากแต่ละใบ"
            }
          }
        },
        "required": [
          "id",
          "user_id",
          "pattern",
          "requested_count",
          "allocated_count",
          "status",
          "created_at",
          "expires_at",
          "updated_at",
          "tickets"
        ]
      },
      "SearchData": {
        "type": "object",
        "description": "ผลการค้นหาและจอง",
        "properties": {
          "reservation": {
            "$ref": "#/components/schemas/Reservation",
            "description": "การจองเดิมพร้อมสถานะปัจจุบัน หากถึงเวลาหมดอายุให้จัดการ expiry ก่อนคืนผล"
          },
          "replayed": {
            "type": "boolean",
            "description": "false เมื่อสร้างใหม่และตอบ 201; true เมื่อได้รายการเดิมจาก key เดิมและตอบ 200 ไม่ต่อเวลา hold"
          }
        },
        "required": [
          "reservation",
          "replayed"
        ]
      },
      "SearchResponse": {
        "type": "object",
        "description": "Response ของ search ทั้งกรณีสร้างใหม่และ retry",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SearchData",
            "description": "ผลการค้นหาและจอง ประกอบด้วย reservation กับ replayed"
          },
          "request_id": {
            "type": "string",
            "description": "UUID ที่ server สร้างสำหรับติดตาม HTTP request ครั้งนี้ จึงเปลี่ยนได้แม้ retry การจองเดิม",
            "format": "uuid"
          }
        },
        "required": [
          "data",
          "request_id"
        ]
      },
      "ReservationResponse": {
        "type": "object",
        "description": "Response ของ get, confirm และ release",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Reservation",
            "description": "ข้อมูลการจองของเจ้าของ get อาจคืน status=expired ด้วย HTTP 200 ได้"
          },
          "request_id": {
            "type": "string",
            "description": "UUID ที่ server สร้างสำหรับติดตาม HTTP request ครั้งนี้",
            "format": "uuid"
          }
        },
        "required": [
          "data",
          "request_id"
        ]
      },
      "ErrorDetail": {
        "type": "object",
        "description": "รายละเอียดว่า field ใดไม่ผ่าน validation",
        "properties": {
          "field": {
            "type": "string",
            "description": "ชื่อหรือ path ของ field ที่ไม่ถูกต้อง เช่น pattern"
          },
          "message": {
            "type": "string",
            "description": "คำอธิบายที่อ่านให้ผู้ใช้หรือ developer เข้าใจ ไม่ควรให้ client แยกข้อความนี้เพื่อเลือก logic"
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "Error": {
        "type": "object",
        "description": "รหัสข้อผิดพลาดสำหรับโปรแกรม พร้อมข้อความอธิบาย",
        "properties": {
          "code": {
            "type": "string",
            "description": "รหัสคงที่สำหรับให้ client เลือกวิธีจัดการร่วมกับ HTTP status ดูรายการในตาราง error codes",
            "enum": [
              "INVALID_REQUEST",
              "UNAUTHENTICATED",
              "RESERVATION_NOT_FOUND",
              "ALLOCATION_UNAVAILABLE",
              "IDEMPOTENCY_CONFLICT",
              "STATE_CONFLICT",
              "RESERVATION_EXPIRED",
              "RATE_LIMITED",
              "TEMPORARILY_UNAVAILABLE",
              "DEADLINE_EXCEEDED",
              "INTERNAL_ERROR"
            ]
          },
          "message": {
            "type": "string",
            "description": "คำอธิบายที่ไม่เปิดเผย SQL, secret หรือ token"
          },
          "details": {
            "type": "array",
            "description": "รายละเอียด field ที่ไม่ผ่าน validation เป็น optional field ละได้เมื่อไม่เกี่ยวกับ field และห้ามเป็น null",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail",
              "description": "ชื่อ field และสาเหตุที่ไม่ผ่าน validation"
            }
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Response ข้อผิดพลาดของ endpoints ที่กำหนดไว้",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error",
            "description": "รหัสและข้อความอธิบายข้อผิดพลาด รวมรายละเอียด field ถ้ามี"
          },
          "request_id": {
            "type": "string",
            "description": "UUID สำหรับติดตาม request ที่ไม่สำเร็จด้วย",
            "format": "uuid"
          }
        },
        "required": [
          "error",
          "request_id"
        ]
      }
    }
  }
